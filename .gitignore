# Go build artifacts
*.exe
*.dll
*.so
*.dylib

# Binary output directory - ignore contents but keep the directory
bin/*
!bin/.gitkeep

# Data files
data/*.db

# Logs
logs/*.log

# Temporary files directory
# Used for: temporary files, redirect error files, screenshots, debug dumps, etc.
tmp/*
!tmp/.gitkeep

# Temporary file patterns
*.tmp
*.temp
*.dump
*.crash
*.core

# Screenshot and image dumps
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg
# 但保留仓库中的网页横幅资源(SVG 随代码入库)
!src/web/assets/*.svg
screenshots/
screencaps/

# Redirect and error files
*.redirect
*.error
stderr.log
stdout.log
*.log.*

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Go vendor directory
vendor/

# Test coverage files
*.out
coverage.html
coverage.txt

# Backup files
*.bak
*.backup

# Reference PHP project (large, optional)
# Uncomment if you don't want to track the reference PHP code
# ref/

# Environment files
.env
.env.local
.env.*.local
